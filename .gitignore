# ==========================================
# Python
# ==========================================

__pycache__/
*.py[cod]
*$py.class
**/*.egg-info/

# ==========================================
# Virtual Environment
# ==========================================

.venv/
venv/

# ==========================================
# Jupyter
# ==========================================

.ipynb_checkpoints/

# ==========================================
# IDE
# ==========================================

.vscode/
.idea/

# ==========================================
# OS
# ==========================================

.DS_Store
Thumbs.db

# ==========================================
# Dataset Images
# Keep folder structure only
# ==========================================

dataset/raw/*
dataset/processed/*
dataset/reports/*

!dataset/raw/.gitkeep
!dataset/processed/.gitkeep
!dataset/reports/.gitkeep

# ==========================================
# Trained Models & Experiments
# ==========================================

artifacts/models/*

# Keep legacy folder
!artifacts/models/legacy/

# Ignore everything inside legacy
artifacts/models/legacy/*

# Keep legacy structure
!artifacts/models/legacy/.gitkeep

# ==========================================
# XAI Heatmaps
# ==========================================

artifacts/heatmaps/**/*.png
artifacts/heatmaps/**/*.jpg
artifacts/heatmaps/**/*.jpeg
artifacts/heatmaps/**/*.svg
artifacts/heatmaps/**/*.tiff
artifacts/heatmaps/**/*.tif

# Keep folder structure
!artifacts/heatmaps/.gitkeep

# ==========================================
# Evaluation Outputs
# ==========================================

artifacts/metrics/**/*.csv
artifacts/metrics/**/*.xlsx
artifacts/metrics/**/*.json
artifacts/metrics/**/*.parquet

# EDA Outputs

artifacts/metrics/eda/*

# Keep folder structure
!artifacts/metrics/eda/.gitkeep

# ==========================================
# TensorBoard
# ==========================================

logs/
tensorboard_logs/

# ==========================================
# Temporary Files
# ==========================================

*.tmp
*.temp

# ==========================================
# Notebook Autosave
# ==========================================

*.nbconvert.ipynb